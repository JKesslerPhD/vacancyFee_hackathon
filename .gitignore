# Large data files (distribute via Google Drive, not Git)
*.gpkg
*.csv
*.geojson
*.kml
*.xlsx
*.zip
*.parquet
*.joblib

# ...but the small, stable boundary layers are tracked (built by prep_layers.py)
!maps/data/sacramento_county.geojson
!maps/data/council_districts.geojson

# ...and the small QC audit report (~1,500 rows) is tracked so reviewers can
# see exactly which parcels qc_vacancy_exclusions.py flagged, and why,
# without regenerating it.
!hackathon_data/qc_exclusion_report.csv

# ...and the small per-district revenue rollup (9 rows) is tracked; the large
# per-parcel detail (revenue_impact/results/parcel_revenue_estimates.csv)
# stays regenerate-locally like everything else derived from vacant_parcels.
!revenue_impact/results/district_revenue_summary.csv

# Raw source data (anchored to repo root so it does NOT also swallow maps/data/)
/data/
hackathon_data/raw_data/
hackathon_data/reference_data/parcels/

# CA Property Estimator lives in the CARB AB 2446 project, not this repo --
# this whole directory (source + its scored parquet/model output, 100s of MB)
# is local-only. This repo just reads ca_property_estimator/results/parcels_
# market_value_estimated.csv, which someone has to place here by hand (copy
# from a teammate or the CARB project's own output).
ca_property_estimator/

# Generated binary docs
*.docx

# ...except the district brief's editable Word version -- it's a small,
# deliberate deliverable (so Karina/staff can edit it directly), not a
# scratch export.
!district_briefs/*.docx

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# System / IDE
*.stackdump
bash.exe.stackdump
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code project files
.claude/

# One-off / setup scripts (not part of public pipeline). Anchored to repo
# root so it doesn't also swallow ca_property_estimator/scripts/, which IS
# part of the public pipeline.
/scripts/

# Map-suite intermediates — regenerated by maps/prep_layers.py + render_maps.py
# (hs_311.gpkg is already covered by *.gpkg above; the density rasters here):
maps/data/*.tif
maps/data/*.tif.aux.xml
maps/_render.log

# Already-committed figures + summary reports stay tracked (hackathon deliverable);
# delete the lines above if you want to remove them and regenerate locally only.
# To stop tracking generated artifacts going forward:
#   git rm --cached parcel_actualValue/figures/*.png parcel_actualValue/*.txt parcel_actualValue/prop13_deflator.csv
